{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 0,
  "margin-top": 3,
  "margin-left": 5,
  "margin-right": 5,
  "exclusive": true,
  "passthrough": false,

  "modules-left": [
    "custom/launcher",
    "group/workspaces",
    "group/apps"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "hyprland/window",
    "group/system"
  ],

  "custom/launcher": {
    "format": "",
    "on-click": "radiqctl toggle",
    "tooltip": false
  },

  "group/workspaces": {
    "orientation": "horizontal",
    "modules": [
      "hyprland/workspaces"
    ]
  },

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "default": ""
    }
  },

  "group/apps": {
    "orientation": "horizontal",
    "modules": [
      "custom/terminal",
      "custom/browser",
      "custom/files"
    ]
  },

  "custom/terminal": {
    "format": "",
    "on-click": "kitty",
    "tooltip": "Terminal"
  },

  "custom/browser": {
    "format": "󰖟",
    "on-click": "google-chrome-stable",
    "tooltip": "Chrome"
  },

  "custom/files": {
    "format": "",
    "on-click": "thunar",
    "tooltip": "Files"
  },

  "clock": {
    "timezone": "Asia/Kolkata",
    "format": "{:%I:%M %p}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },

  "hyprland/window": {
    "format": "{class}  {title}",
    "max-length": 45,
    "separate-outputs": true
  },

  "group/system": {
    "orientation": "horizontal",
    "modules": [
      "backlight",
      "network",
      "bluetooth",
      "pulseaudio",
      "custom/battery",
      "cpu",
      "memory"
    ]
  },

  "backlight": {
    "format": "{percent}% {icon}",
    "format-icons": [
      "󰃞",
      "󰃟",
      "󰃠"
    ],
    "on-click": "~/.config/waybar/brightness-menu.sh",
    "on-scroll-up": "brightnessctl -e4 -n2 set 5%+",
    "on-scroll-down": "brightnessctl -e4 -n2 set 5%-",
    "tooltip-format": "Brightness: {percent}%\nClick: brightness control"
  },
  
  "network": {
    "format-wifi": "",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "format-disabled": "󰤮",
    "tooltip-format-wifi": "Wi-Fi: {essid}\nSignal: {signalStrength}%\nClick: choose network\nRight-click: Wi-Fi on/off",
    "tooltip-format-ethernet": "Ethernet: {ifname}",
    "tooltip-format-disconnected": "Wi-Fi disconnected\nClick: choose network\nRight-click: Wi-Fi on/off",
    "tooltip-format-disabled": "Wi-Fi turned off\nClick: choose network\nRight-click: Wi-Fi on/off",

    "on-click": "~/.config/waybar/wifi-menu.sh",
    "on-click-right": "if [ $(nmcli radio wifi) = 'enabled' ]; then nmcli radio wifi off && notify-send 'Wi-Fi' 'Wi-Fi turned off'; else nmcli radio wifi on && notify-send 'Wi-Fi' 'Wi-Fi turned on'; fi",

    "interval": 3
   },

  "bluetooth": {
    "format": "",
    "format-disabled": "",
    "format-off": "",
    "format-connected": "",
    "tooltip-format": "{num_connections} connected",
    "on-click": "~/.config/waybar/bluetooth-menu.sh",
    "on-click-right": "bluetoothctl power off",
    "on-click-middle": "bluetoothctl power on"
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ],
      "headphone": "",
      "headset": ""
    },
    "on-click": "~/.config/waybar/audio-menu.sh",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-middle": "pavucontrol",
    "tooltip-format": "Audio: {volume}%\nClick: control center\nRight-click: mute toggle"
  },

  "custom/battery": {
    "exec": "~/.config/waybar/battery.py",
    "return-type": "json",
    "interval": 2,
    "signal": 8,
    "on-click": "~/.config/waybar/power-profile-toggle.sh",
    "tooltip": true
  },

  "cpu": {
    "format": "󰍛 {usage}%",
    "interval": 5
  },

  "memory": {
    "format": " {percentage}%",
    "interval": 5
  }
}
